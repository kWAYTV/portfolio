{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:stream": "turbo run dev --ui=stream",
    "dev:web": "turbo run -F web dev",
    "fix": "ultracite fix",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "pnpm dlx bumpp -r",
    "update": "pnpm dlx taze -r -w -f"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,scss,md,mdx,html,yaml,yml}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@repo/config": "workspace:*",
    "@types/node": "^24.19.2",
    "bumpp": "^12.3.0",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
